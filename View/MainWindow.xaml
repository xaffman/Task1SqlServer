<Window x:Class="Task1SqlServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Task1SqlServer"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Height="550"
        Width="910"
        FontFamily="Consolas">
    <Grid Background="DarkOliveGreen">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="490"/>
        </Grid.ColumnDefinitions>
        <StackPanel HorizontalAlignment="Center"
                    Margin="5 20 5 0"
                    Grid.Column="0">
            <TextBlock
                   FontSize="30"
                   Foreground="White"
                   FontWeight="SemiBold"
                   Margin="0 0 0 10" Text="Ресторан быстрого питания"/>
            <TextBlock TextWrapping="Wrap"
                   Foreground="LightGray"
                   FontSize="25"
                   FontWeight="Light"
                   Text="Форма для заказа съедобных предметов."/>
        </StackPanel>

        <Border Grid.Column="1"
         HorizontalAlignment="Center"
         VerticalAlignment="Center"
         Width="460"
         Height="460"
         Background="White"
         CornerRadius="15"
         Effect="{StaticResource MaterialDesignElevationShadow16}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0"
                    Grid.Column="1"
                    Text="Сделать заказ"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    FontSize="30"
                    FontWeight="SemiBold"/>
                <StackPanel Grid.Row="1"
                     Grid.Column="1"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="0 0 0 0">
                    <StackPanel Orientation="Horizontal"
                                >
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Person"
                                                     Margin="0 0 3 0"
                                                     Width="25"
                                                     Height="25"/>
                            <TextBox Width="145"
                                     FontSize="17"
                                     Name="TbLogin"
                                     
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     materialDesign:HintAssist.Hint="Введите Имя" TextChanged="TbLogin_TextChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="20 0 0 0">
                            <materialDesign:PackIcon Kind="Person"
                                                     Margin="0 0 3 0"
                                                     Width="25"
                                                     Height="25"/>
                            <TextBox Width="168"
                                         FontSize="17"
                                         Name="PbPassword"
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         materialDesign:HintAssist.Hint="Введите Фамилию"/>
                        </StackPanel>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0 30 0 0">
                        <materialDesign:PackIcon Kind="Phone"
                                             Margin="0 0 3 0"
                                             Width="25"
                                             Height="25"/>
                        <TextBox Width="362"
                               FontSize="17"
                               Name="TbPhone"
                               materialDesign:HintAssist.HelperText="В формате +7-(777)-777-77-77"
                               materialDesign:TextFieldAssist.HasClearButton="True"
                               materialDesign:HintAssist.Hint="Введите мобильный номер телефона"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0 30 0 0">
                        <materialDesign:PackIcon Kind="Email"
                                                 Margin="0 2 3 0"
                                                 Width="25"
                                                 Height="25"/>
                        <TextBox Width="362"
                              FontSize="17"
                              Name="TbEmail"
                              materialDesign:HintAssist.HelperText="г. N, ул. N, д. N, ул. N"
                              materialDesign:TextFieldAssist.HasClearButton="True"
                              materialDesign:HintAssist.Hint="Введите адрес доставки"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0 30 0 0">
                        <CheckBox Content="Политика конфиденциальности информации"
                                  IsChecked="True"
                                  Background="Black"
                                  IsEnabled="False"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0 30 0 0">
                        <CheckBox Content="Получать рекламу предметов через СМС-сообщения"
                                  IsChecked="True"
                                  Cursor="Hand"
                                  Background="Black"/>
                    </StackPanel>
                </StackPanel>

                <Separator Background="Gray"
                           Height="5"
                           Width="380"
                           Grid.Column="1"
                           Grid.Row="1"
                           VerticalAlignment="Bottom"/>
                <StackPanel Grid.Column="1"
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button BorderBrush="Black"
                            BorderThickness="1"
                            x:Name="BtnCreate"
                            Background="Transparent"
                            Foreground="Black"
                            Click="BtnCreate_Click_1"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonProgressAssist.Value="-1"
                            materialDesign:ButtonProgressAssist.IndicatorBackground="Transparent"
                            materialDesign:ButtonProgressAssist.IndicatorForeground="Black"
                            materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                            materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                            IsEnabled="{Binding DataContext.ControlsEnables,
                                        RelativeSource={RelativeSource FindAncestor,
                                        AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Create"/>
                            <TextBlock Text="Сделать заказ"/>
                        </StackPanel>
                    </Button>

                    <TextBlock TextAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="10 0 0 0">
                        <Run>Или посмотреть </Run>
                        <Run TextDecorations="Underline"
                             FontWeight="SemiBold"
                             Cursor="Hand"
                             MouseLeftButtonDown="Run_MouseLeftButtonDown">Меню</Run>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        <Image Margin="0,400,230,0" Source="/images/Vkusno_I_Tochka_symbol.svg.png" Stretch="Fill"/>
    </Grid>
</Window>